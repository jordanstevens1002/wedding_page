{
    "openapi": "3.0.3",
    "info": {
        "title": "Wedding Website API",
        "version": "0.1.0"
    },
    "paths": {
        "/api/health/live/": {
            "get": {
                "operationId": "health_live_retrieve",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/health/ready/": {
            "get": {
                "operationId": "health_ready_retrieve",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Health": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "ok",
                    "unavailable"
                ],
                "type": "string",
                "description": "* `ok` - ok\n* `unavailable` - unavailable"
            }
        }
    }
