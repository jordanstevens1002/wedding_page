{
    "openapi": "3.0.3",
    "info": {
        "title": "Wedding Website API",
        "version": "0.1.0"
    },
    "paths": {
        "/api/editor/csrf/": {
            "get": {
                "operationId": "editor_csrf_retrieve",
                "tags": [
                    "editor"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Token"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/editor/login/": {
            "post": {
                "operationId": "editor_login_create",
                "tags": [
                    "editor"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "No response body"
                    },
                    "429": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/editor/logout/": {
            "post": {
                "operationId": "editor_logout_create",
                "tags": [
                    "editor"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/editor/media/": {
            "get": {
                "operationId": "editor_media_list",
                "parameters": [
                    {
                        "name": "page",
                        "required": false,
                        "in": "query",
                        "description": "A page number within the paginated result set.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page_size",
                        "required": false,
                        "in": "query",
                        "description": "Number of results to return per page.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "tags": [
                    "editor"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedAssetList"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "editor_media_create",
                "tags": [
                    "editor"
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Upload"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Upload"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Asset"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/editor/media/{id}/": {
            "get": {
                "operationId": "editor_media_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "editor"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Asset"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "delete": {
                "operationId": "editor_media_destroy",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "editor"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    },
                    "409": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/editor/password/": {
            "post": {
                "operationId": "editor_password_create",
                "tags": [
                    "editor"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Password"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Password"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Password"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/editor/session/": {
            "get": {
                "operationId": "editor_session_retrieve",
                "tags": [
                    "editor"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/editor/site/draft/": {
            "get": {
                "operationId": "editor_site_draft_retrieve",
                "tags": [
                    "editor"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Draft"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "put": {
                "operationId": "editor_site_draft_update",
                "tags": [
                    "editor"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DraftWrite"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/DraftWrite"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/DraftWrite"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Draft"
                                }
                            }
                        },
                        "description": ""
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Conflict"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/health/live/": {
            "get": {
                "operationId": "health_live_retrieve",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/health/ready/": {
            "get": {
                "operationId": "health_ready_retrieve",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/media/{id}/": {
            "get": {
                "operationId": "media_metadata_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "media"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicAsset"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/media/{id}/{width}/": {
            "get": {
                "operationId": "media_image_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    },
                    {
                        "in": "path",
                        "name": "width",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "media"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "image/webp": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/site/": {
            "get": {
                "operationId": "site_retrieve",
                "tags": [
                    "site"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicSite"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Asset": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "width": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "height": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Variant"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "height",
                    "id",
                    "variants",
                    "width"
                ]
            },
            "Conflict": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    },
                    "revision": {
                        "type": "integer"
                    }
                },
                "required": [
                    "detail",
                    "revision"
                ]
            },
            "ContentEntry": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 140
                    },
                    "body": {
                        "type": "string",
                        "default": "",
                        "maxLength": 4000
                    },
                    "url": {
                        "oneOf": [
                            {
                                "type": "string",
                                "default": "",
                                "format": "uri",
                                "maxLength": 2048
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "starts_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "image": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ImageReference"
                            }
                        ],
                        "nullable": true
                    }
                },
                "required": [
                    "id",
                    "title"
                ]
            },
            "Draft": {
                "type": "object",
                "properties": {
                    "revision": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "document": {
                        "$ref": "#/components/schemas/SiteDocument"
                    }
                },
                "required": [
                    "document",
                    "revision"
                ]
            },
            "DraftWrite": {
                "type": "object",
                "properties": {
                    "base_revision": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "document": {
                        "$ref": "#/components/schemas/SiteDocument"
                    }
                },
                "required": [
                    "base_revision",
                    "document"
                ]
            },
            "Health": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "IdEnum": {
                "enum": [
                    "welcome",
                    "story",
                    "schedule",
                    "venue",
                    "travel",
                    "accommodation",
                    "faq",
                    "registry",
                    "gallery"
                ],
                "type": "string",
                "description": "* `welcome` - welcome\n* `story` - story\n* `schedule` - schedule\n* `venue` - venue\n* `travel` - travel\n* `accommodation` - accommodation\n* `faq` - faq\n* `registry` - registry\n* `gallery` - gallery"
            },
            "ImageReference": {
                "type": "object",
                "properties": {
                    "asset_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "alt_text": {
                        "type": "string",
                        "default": "",
                        "maxLength": 500
                    },
                    "decorative": {
                        "type": "boolean",
                        "default": false
                    },
                    "caption": {
                        "type": "string",
                        "default": "",
                        "maxLength": 1000
                    },
                    "focal_x": {
                        "type": "number",
                        "format": "double",
                        "maximum": 1,
                        "minimum": 0,
                        "default": 0.5
                    },
                    "focal_y": {
                        "type": "number",
                        "format": "double",
                        "maximum": 1,
                        "minimum": 0,
                        "default": 0.5
                    }
                },
                "required": [
                    "asset_id"
                ]
            },
            "Login": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "maxLength": 1024
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            },
            "PaginatedAssetList": {
                "type": "object",
                "required": [
                    "count",
                    "results"
                ],
                "properties": {
                    "count": {
                        "type": "integer",
                        "example": 123
                    },
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=4"
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=2"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Asset"
                        }
                    }
                }
            },
            "Password": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string",
                        "writeOnly": true,
                        "maxLength": 1024
                    },
                    "new_password": {
                        "type": "string",
                        "writeOnly": true,
                        "maxLength": 1024
                    }
                },
                "required": [
                    "current_password",
                    "new_password"
                ]
            },
            "PublicAsset": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "width": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "height": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Variant"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "height",
                    "id",
                    "variants",
                    "width"
                ]
            },
            "PublicDocument": {
                "type": "object",
                "properties": {
                    "schema_version": {
                        "$ref": "#/components/schemas/SchemaVersionEnum"
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 140
                    },
                    "couple_names": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "wedding_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "timezone": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "sections": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Section"
                        }
                    }
                },
                "required": [
                    "couple_names",
                    "schema_version",
                    "sections",
                    "timezone",
                    "title",
                    "wedding_date"
                ]
            },
            "PublicSite": {
                "type": "object",
                "properties": {
                    "configured": {
                        "type": "boolean"
                    },
                    "document": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/PublicDocument"
                            }
                        ],
                        "nullable": true
                    }
                },
                "required": [
                    "configured",
                    "document"
                ]
            },
            "SchemaVersionEnum": {
                "enum": [
                    1
                ],
                "type": "integer",
                "description": "* `1` - 1"
            },
            "Section": {
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/IdEnum"
                    },
                    "heading": {
                        "type": "string",
                        "maxLength": 140
                    },
                    "body": {
                        "type": "string",
                        "maxLength": 8000
                    },
                    "visible": {
                        "type": "boolean"
                    },
                    "entries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ContentEntry"
                        }
                    },
                    "image": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ImageReference"
                            }
                        ],
                        "nullable": true
                    }
                },
                "required": [
                    "body",
                    "entries",
                    "heading",
                    "id",
                    "visible"
                ]
            },
            "Session": {
                "type": "object",
                "properties": {
                    "csrf_token": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                },
                "required": [
                    "csrf_token",
                    "username"
                ]
            },
            "SiteDocument": {
                "type": "object",
                "properties": {
                    "schema_version": {
                        "$ref": "#/components/schemas/SchemaVersionEnum"
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 140
                    },
                    "couple_names": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "wedding_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "timezone": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "sections": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Section"
                        }
                    }
                },
                "required": [
                    "couple_names",
                    "schema_version",
                    "sections",
                    "timezone",
                    "title",
                    "wedding_date"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "ok",
                    "unavailable"
                ],
                "type": "string",
                "description": "* `ok` - ok\n* `unavailable` - unavailable"
            },
            "Token": {
                "type": "object",
                "properties": {
                    "csrf_token": {
                        "type": "string"
                    }
                },
                "required": [
                    "csrf_token"
                ]
            },
            "Upload": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "required": [
                    "file"
                ]
            },
            "Variant": {
                "type": "object",
                "properties": {
                    "width": {
                        "type": "integer"
                    },
                    "height": {
                        "type": "integer"
                    },
                    "url": {
                        "type": "string"
                    }
                },
                "required": [
                    "height",
                    "url",
                    "width"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}
